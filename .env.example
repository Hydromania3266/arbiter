# ─── FREELLMAPI (free models — già incluso) ───
FREELLMAPI_KEY=freellmapi-f26f249af5e64368808e830b8b931aacf0ebd5217c4cf310

# ─── TRADING ───
PAPER_MODE=true                          # metti "false" quando sei pronto per i soldi veri
INITIAL_CAPITAL=100000                   # capitale iniziale in USD
RISK_PERCENT_PER_TRADE=2.0              # % capitale a rischio per trade
MAX_POSITIONS=5                          # posizioni massime aperte

# ─── MODELLI AI PER RUOLO (tutti gratis) ───
ROLE_ANALYST=gemini-3.8-flash
ROLE_RISK=glm-5.3-flash
ROLE_EXECUTOR=qwen3.8-flash
ROLE_REVIEWER=agnes-2.5-flash
ROLE_IMPROVEMENT=deepseek-v4-flash

# ─── APPRENDIMENTO AUTOMATICO ───
LEARNING_ENABLED=true
MIN_TRADES_BEFORE_LIVE=20               # trade paper prima di passare a live
TARGET_WIN_RATE=0.55                     # win rate minimo per passare a live

# ─── EXCHANGE (Binance — gratuito, 5 min per registrarsi) ───
# Vai su https://www.binance.com → Account → API Management → crea chiave
# Non abilitare "Enable Withdrawals"! Solo "Enable Spot & Margin Trading"
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# ─── TELEGRAM NOTIFICHE (opzionale) ───
# 1. Cerca @BotFather su Telegram → /newbot → segui le istruzioni
# 2. Copia il TOKEN che ti da
# 3. Cerca @myidbot → copia il tuo chat_id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── WEB UI ───
WEB_PORT=8080
